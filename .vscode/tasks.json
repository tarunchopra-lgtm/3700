{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch: stock_alert",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "indicator\\stock_alert.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUNBUFFERED": "1"
                }
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "group": "watchers"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "watch: email_status",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "indicator\\email_status.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUNBUFFERED": "1"
                }
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "group": "watchers"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "watch: start all",
            "dependsOn": [
                "watch: stock_alert",
                "watch: email_status"
            ],
            "problemMatcher": []
        }
    ]
}
